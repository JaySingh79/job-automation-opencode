# Copy to .env and fill in real values. Never commit .env.
FIRECRAWL_API_KEY=fc-YOUR_KEY_HERE
STEEL_API_KEY=ste-YOUR_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
MODEL=gemini-3.1-flash-lite
INSTAHYRE_USERNAME=user@example.com
INSTAHYRE_PASSWORD=REPLACE_WITH_INSTAHYRE_PASSWORD
PLAYWRIGHT_MCP_USER_DATA_DIR="C:\\path\\to\\Chrome\\User Data"
PLAYWRIGHT_MCP_PROFILE_DIR="Profile 1"
LANGSMITH_API_KEY="lsv2_pt_YOUR_KEY_HERE"
LANGSMITH_PROJECT="opencode"
TRACE_TO_LANGSMITH="true"
GRAPH_DB_PASSWORD=REPLACE_WITH_GRAPH_DB_PASSWORD
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
AURA_INSTANCEID="YOUR_AURA_INSTANCE_ID"
COCOINDEX_DB=./cocoindex.db
llm_model=openai/o4-mini-high
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
