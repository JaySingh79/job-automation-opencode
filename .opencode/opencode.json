{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "C:/Users/binit/.local/bin/headroom.exe",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--user-data-dir=C:/Users/binit/AppData/Local/Google/Chrome/User Data/Profile"
      ],
      "enabled": true
    },
    "playwright-extention": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--extension"
      ],
      "env":{
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "zse8LU4TdA0oWJd6zW6hEoDiulMg3qB4Sxw6hzeXikQ"
      },
      "enabled": true
    },
    "gmail": {
      "type": "remote",
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "enabled": true
    }
  },
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "skills": {
    "paths": [
      "C:/Users/binit/.config/opencode/skills"
    ]
  },
"permission": {
    "*": "allow",

    "bash": {
      "*": "allow",
      "git config --global user.name *": "ask",
      "git config --global user.email *": "ask"
    },

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "**/secrets/**": "deny",
      "*.env.example": "allow",
      "**/opencode.json": "deny"
    },

    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "**/secrets/**": "deny",
      "../**": "deny",
      "**/opencode.json": "deny"
    },

    "external_directory": "deny"
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".venv/**",
      "venv/**",
      "env/**",
      "__pycache__/**",
      "dist/**",
      "build/**",
      ".next/**",
      "coverage/**",
      "**.pytest_cache/**",
      "**.ruff_cache/**",
      "**.git/**"
    ]
  }
}